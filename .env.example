# 実際の値は .env に置く（.env はGit管理外）。ここにはプレースホルダーのみを書く。
# EXAMPLE_API_KEY=your-api-key-here

# --- Routine optional reasoning（正本: routines/ROUTINES.md） ---
# .env が無くても決定的Maintenanceは完全に動作する。以下はすべて任意。

# false の場合、Routineは決定的Maintenanceだけで動作し、外部Providerへ送信しない。
# true は「Maintenanceに必要な限定データを選択Providerへ送る」standing approvalになる。
AGENT_ROUTINE_REASONING_ENABLED=false

# deepseek | openai | anthropic のいずれか1つ。自動fallbackは行わない。
AGENT_ROUTINE_REASONING_PROVIDER=

# Provider側のmodel ID。利用者が明示設定する（既定値はハードコードしない）。
AGENT_ROUTINE_REASONING_MODEL=

# 実行予算
AGENT_ROUTINE_REASONING_TIMEOUT_SECONDS=120
AGENT_ROUTINE_REASONING_MAX_MODEL_CALLS=1
AGENT_ROUTINE_REASONING_MAX_OUTPUT_TOKENS=4096

# Provider keys（選択したProviderのものだけ設定する）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 任意のendpoint override（通常は空のまま）
DEEPSEEK_BASE_URL=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
